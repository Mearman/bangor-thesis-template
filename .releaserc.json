{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "printf '\\\\templateversion{v%s}\\n' \"${nextRelease.version}\" > version.tex && latexmk -pdf -interaction=nonstopmode main.tex"
      }
    ],
    ["@semantic-release/git", { "assets": ["CHANGELOG.md", "version.tex"] }],
    ["@semantic-release/github", { "assets": ["main.pdf"] }]
  ]
}
