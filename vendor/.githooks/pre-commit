#!/bin/sh
# Auto-format staged LaTeX sources with latexindent, then gate on
# chktex errors. Both tools ship with TeX Live. If a tool is missing,
# say so and let the commit continue: CI is the authoritative gate.
set -u

staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(sty|cls|tex)$' || true)
[ -z "$staged" ] && exit 0

if command -v latexindent >/dev/null 2>&1; then
  for f in $staged; do
    latexindent -silent -l .latexindent.yaml -w "$f" 2>/dev/null && rm -f "$f.bak0" || true
    git add "$f"
  done
else
  echo "note: latexindent not found; install TeX Live for local formatting"
fi

status=0
if command -v chktex >/dev/null 2>&1; then
  for f in $staged; do
    out=$(chktex -q "$f" 2>&1 || true)
    # chktex exit codes conflate warnings with errors, so gate on the
    # diagnostics themselves: only Error lines fail the commit.
    if printf '%s\n' "$out" | grep -q "Error"; then
      echo "chktex errors in $f"
      printf '%s\n' "$out" | grep "Error"
      status=1
    fi
  done
else
  echo "note: chktex not found; install TeX Live for local linting"
fi

exit $status
