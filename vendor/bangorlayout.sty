%%% bangorlayout.sty — regulation presentation and its enforcement
% Selects the font, page geometry, and line spacing permitted by the
% Bangor University thesis regulations (Regulation 03, 2025 Version 01,
% section 6.3) and validates them. Strict mode is on by default: a
% violation fails the build. Setting strict=false downgrades every
% violation to a warning so the document still compiles.
%
% The validator governs settings made through this package. It cannot
% see arbitrary preamble changes made around it.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bangorlayout}[2026/09/21 v5.0.0 Bangor University regulation layout]
\bangorstamppart{bangorlayout}{bangorlayout.sty}

\RequirePackage{kvoptions}
\RequirePackage{setspace}
\RequirePackage{geometry}

\SetupKeyvalOptions{family=bgl,prefix=bgl@}
% Font choices are free TeX Live equivalents of the regulation's named
% example faces: termes (Times-Roman), bonum (Bookman), heros (Arial
% and Helvetica). The first two are serif; heros is sans-serif.
\DeclareStringOption[termes]{font}[termes]
\DeclareBoolOption[true]{strict}
\ProcessKeyvalOptions{bgl}

% Regulation floors the layout enforces.
\newcommand{\bgl@bindingfloor}{2.5cm}
\newcommand{\bgl@otherfloor}{1.5cm}
\newcommand{\bgl@serifsizefloor}{12}
\newcommand{\bgl@sanssizefloor}{10}

% Report a regulation violation: build-failing error in strict mode,
% warning otherwise. The public form lets consumers route their own
% regulation checks through the same strict/warn switch, so one option
% governs every check in the document.
\newcommand{\bgl@violation}[1]{%
  \ifbgl@strict
    \PackageError{bangorlayout}{#1}%
    {Set strict=false on the class or package line to compile anyway.}%
  \else
    \PackageWarningNoLine{bangorlayout}{#1}%
  \fi}
\newcommand{\bangorregulationviolation}[1]{\bgl@violation{#1}}

% Font selection. The kvoptions string option is matched against the
% permitted choices; an unknown choice is a violation with the serif
% default as the fallback.
\newif\ifbgl@serif
\newif\ifbgl@heros
\bgl@seriftrue
\bgl@herosfalse
\def\bgl@choicetermes{termes}
\def\bgl@choicebonum{bonum}
\def\bgl@choiceheros{heros}
\ifx\bgl@font\bgl@choicetermes
  \RequirePackage{tgtermes}%
\else\ifx\bgl@font\bgl@choicebonum
    \RequirePackage{tgbonum}%
  \else\ifx\bgl@font\bgl@choiceheros
      \RequirePackage{tgheros}%
      \bgl@seriffalse
      \bgl@herostrue
    \else
      \bgl@violation{Unknown font choice `\bgl@font'. Permitted choices:
        termes, bonum, heros. Using termes.}%
      \RequirePackage{tgtermes}%
    \fi\fi\fi
% A sans-serif body uses the sans family as the document default.
\ifbgl@heros
  \renewcommand{\familydefault}{\sfdefault}%
\fi

% Regulation geometry: 2.5cm binding edge, 2cm on the remaining sides
% (above the regulation's 1.5cm floor), header and footer inside the
% text block.
\geometry{a4paper,inner=2.5cm,outer=2cm,top=2cm,bottom=2cm,includeheadfoot}

% Regulation spacing: 1.5 in the main text. The abstract, indented
% quotations, and footnotes may be single spaced; consumers apply that
% themselves through the singlespace environment.
\onehalfspacing

% Validate at the start of the document, when class and package
% settings have settled.
\AtBeginDocument{%
  % Font size floor for the chosen family.
  \edef\bgl@bodysize{\f@size}%
  \ifbgl@serif
    \ifnum\bgl@bodysize<\bgl@serifsizefloor\relax
      \bgl@violation{Serif body text must be at least
        \bgl@serifsizefloor\space pt.}%
    \fi
  \else
    \ifnum\bgl@bodysize<\bgl@sanssizefloor\relax
      \bgl@violation{Sans-serif body text must be at least
        \bgl@sanssizefloor\space pt.}%
    \fi
  \fi
  % Margin floors, computed from the page geometry so that any margin
  % source is checked, not only this package's own settings. The left
  % margin is the binding edge. The checked extents run to the text
  % body, with header and footer depth included in the vertical
  % margins.
  \ifdim\dimexpr 1in+\hoffset+\oddsidemargin\relax<\bgl@bindingfloor\relax
    \bgl@violation{The binding-edge margin must be at least 2.5cm.}%
  \fi
  \ifdim\dimexpr\paperwidth-\textwidth-1in-\hoffset-\oddsidemargin\relax<\bgl@otherfloor\relax
    \bgl@violation{The outer margin must be at least 1.5cm.}%
  \fi
  \ifdim\dimexpr 1in+\voffset+\topmargin+\headheight+\headsep\relax<\bgl@otherfloor\relax
    \bgl@violation{The top margin must be at least 1.5cm.}%
  \fi
  \ifdim\dimexpr\paperheight-\textheight-1in-\voffset-\topmargin-\headheight-\headsep\relax<\bgl@otherfloor\relax
    \bgl@violation{The bottom margin must be at least 1.5cm.}%
  \fi
  % Line spacing: setspace's onehalfspacing sets the stretch to 1.235,
  % which yields the regulation's 1.5 visual spacing.
  \ifdim\baselinestretch pt<1.2pt\relax
    \bgl@violation{The main text must use 1.5 line spacing.}%
  \fi}

\endinput
