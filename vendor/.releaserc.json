{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./scripts/stamp-version.sh ${nextRelease.version} && texlua l3build/l3build.lua ctan && latexmk -pdf -interaction=nonstopmode doc/bangor.tex"
      }
    ],
    [
      "@semantic-release/git",
      { "assets": ["CHANGELOG.md", "*.sty", "*.cls"] }
    ],
    [
      "@semantic-release/github",
      { "assets": ["bangor.pdf", "bangor-ctan.zip"] }
    ]
  ]
}
