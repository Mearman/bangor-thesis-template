%%% bangorletter.sty — headed letter style for Bangor University
% Renders the university letterhead for use with the standard letter
% document class: the crest at reduced scale, the wordmark, a thin
% rule in the brand red, and the school line when the document sets
% one through bangoridentity. Colours are used sparingly, following
% the brand guidance.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bangorletter}[2026/09/20 v2.2.0 Bangor University headed letter style]

\RequirePackage{bangor}
\RequirePackage{bangoridentity}
\RequirePackage[hidelinks]{hyperref}
\bangorstamppart{bangorletter}{bangorletter.sty}

% Bake the version stamp into the PDF metadata so any reader can see
% which package versions produced the document.
\AtBeginDocument{%
  \hypersetup{pdfsubject={\bangorversionstamp},
  pdfkeywords={Bangor University; \bangorversionstamp}}}

% The letterhead. Put this at the top of a letter environment, before
% the \opening command. The optional argument sets the crest width.
\newcommand{\bangorletterhead}[1][1.5cm]{%
  \begin{center}
    \bangorcrest[#1]\par
    \vspace{0.3em}%
    {\large\bangorwordmark\par}
    \ifx\bgi@school\@empty\else
      \vspace{0.2em}{\small \bgi@school\par}\fi
    \vspace{0.5em}%
    {\color{bangorred}\rule{\linewidth}{0.8pt}}%
  \end{center}
  \vspace{0.5em}}

\endinput
