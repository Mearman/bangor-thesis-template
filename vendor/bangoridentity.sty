%%% bangoridentity.sty — document metadata and rendered identity blocks
% Stores the document-level identity (school, college, degree scheme,
% supervisors, dates, word count) and renders the identity block that
% combines this metadata with the brand facts from bangor.sty.
% School and college are free text on purpose: the university renames
% its schools and colleges, so the package never enumerates them.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bangoridentity}[2026/09/20 v4.1.1 Bangor University document identity]

\RequirePackage{bangor}
\bangorstamppart{bangoridentity}{bangoridentity.sty}

% Metadata storage. Defaults are empty; consumers render conditionally.
\newcommand{\school}[1]{\gdef\bgi@school{#1}}
\newcommand{\college}[1]{\gdef\bgi@college{#1}}
\newcommand{\degreescheme}[1]{\gdef\bgi@degree{#1}}
\newcommand{\submissiondate}[1]{\gdef\bgi@date{#1}}
\def\bgi@school{}
\def\bgi@college{}
\def\bgi@degree{}
\def\bgi@date{}

% Taught dissertations commonly must state their word count. When set,
% consumers print it; research degrees leave it unset.
\newcommand{\submissionwordcount}[1]{\gdef\bgi@wordcount{#1}}
\def\bgi@wordcount{}

% A short form of the title for the running footer. When it is unset,
% consumers fall back to the full title.
\newcommand{\shorttitle}[1]{\gdef\bgi@shorttitle{#1}}
\def\bgi@shorttitle{}

% Supervisors accumulate in declaration order, separated for typesetting.
\def\bgi@supervisors{}
\newcommand{\supervisor}[1]{%
  \ifx\bgi@supervisors\@empty
    \gdef\bgi@supervisors{#1}%
  \else
    \g@addto@macro\bgi@supervisors{\\#1}%
  \fi}

% The rendered identity block: crest, wordmark, then the school and
% college lines when set. Shared by the thesis title page and the
% letter letterhead, so neither consumer typesets brand facts itself.
\newcommand{\bangoridentityblock}[1][2.5cm]{%
  \begin{center}
    \bangorcrest[#1]\par
    \vspace{0.6em}%
    {\Large\bangorwordmark\par}
    \ifx\bgi@school\@empty\else
      \vspace{0.3em}{\large \bgi@school\par}\fi
    \ifx\bgi@college\@empty\else
      {\large \bgi@college\par}\fi
  \end{center}}

\endinput
