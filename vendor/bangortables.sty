%%% bangortables.sty — table pagination and width for Bangor documents
% Loads xltabular (which combines tabularx width-targeting with
% longtable pagination) and pdflscape (for landscape pages). These
% two packages together eliminate the "Float too large for page"
% error class: xltabular paginates at row boundaries and targets
% its declared width by construction, and pdflscape rotates wide
% tables to landscape while keeping page numbers upright.
%
% Use xltabular directly for all tables: column specs use tabularx
% conventions (l, r, c for natural width; X for proportional fill).
% For wide tables, wrap in the landscape environment.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bangortables}[2026/09/20 v1.0.4 Bangor University table support]

\RequirePackage{bangor}
\RequirePackage{xltabular}
\RequirePackage{pdflscape}

\endinput
